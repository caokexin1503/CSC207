@startuml
skinparam dpi 150
skinparam classAttributeIconSize 0
hide empty members

' Your task (Chapter 8, Question 1): draw the UML class diagram for the library
' specification — items, books, DVDs, reference-only items, members, librarians,
' and holds.
'
' Define each type as a box, then connect them with the right arrows. One box
' (Item) is filled in as an example — decide on the rest yourself. There is more
' than one defensible answer.
'
' PlantUML cheat-sheet:
'   interface Name { + method() : Type }
'   abstract class Name { # field : Type }
'   class Name { - field : Type }
'   Parent    <|-- Child    ' generalization: Child extends Parent
'   Interface <|.. Class    ' realization:    Class implements Interface
' (Putting the parent/interface on the LEFT of the arrow keeps it on top, which
'  is the convention used in these notes.)

abstract class Item {
  - title : String
  - catalogueNumber : String
  + getTitle() : String
  + getCatalogueNumber() : String
}

' ---------------------------------------------------------------------------
' My design (Chapter 8, Question 1). Design decisions:
'  * Only some items can be borrowed, so "borrowing" is a capability expressed
'    by the Borrowable interface. ReferenceItem does not implement it, so you
'    cannot even ask to borrow one: the compiler rules it out.
'  * Books and DVDs differ only in loan period. I keep them as subclasses of
'    BorrowableItem (so the catalogue can still tell them apart), but the loan
'    period itself is a field set by each constructor, not overridden behaviour.
'  * Member and Librarian are both people the library knows about and who log
'    in, so they share an abstract LibraryUser supertype. The spec only says
'    members log in with a member number, so the shared "id" is an assumption.
'  * A Hold is remembered by the item it is on: when the item is returned,
'    that item is the object that needs to know who is waiting for it.
' ---------------------------------------------------------------------------

interface Borrowable {
  + getLoanPeriodDays() : int
  + isOnLoan() : boolean
  + checkOut(member : Member) : Loan
  + checkIn() : void
  + placeHold(member : Member) : Hold
}

abstract class BorrowableItem {
  - loanPeriodDays : int
  - currentLoan : Loan
  - holds : List<Hold>
  + getLoanPeriodDays() : int
  + isOnLoan() : boolean
  + checkOut(member : Member) : Loan
  + checkIn() : void
  + placeHold(member : Member) : Hold
  + getHolds() : List<Hold>
}

class Book {
  + {static} LOAN_PERIOD_DAYS : int = 21
  + Book(title : String, catalogueNumber : String)
}

class DVD {
  + {static} LOAN_PERIOD_DAYS : int = 7
  + DVD(title : String, catalogueNumber : String)
}

class ReferenceItem {
  + ReferenceItem(title : String, catalogueNumber : String)
}

class Loan {
  - item : BorrowableItem
  - member : Member
  - dueDate : LocalDate
  + getDueDate() : LocalDate
  + isOverdue(today : LocalDate) : boolean
}

class Hold {
  - item : BorrowableItem
  - member : Member
  - placedOn : LocalDate
  + getMember() : Member
}

abstract class LibraryUser {
  - id : String
  - name : String
  + getId() : String
  + getName() : String
}

class Member {
  - lateFee : double
  - loans : List<Loan>
  + getLateFee() : double
  + setLateFee(amount : double) : void
  + placeHold(item : Borrowable) : Hold
}

class Librarian {
  + addItem(catalogue : Catalogue, item : Item) : void
  + waiveLateFee(member : Member) : void
}

class Catalogue {
  - items : Map<String, Item>
  + addItem(item : Item) : void
  + findItem(catalogueNumber : String) : Item
}

class Library {
  - catalogue : Catalogue
  - members : Map<String, Member>
  + login(memberNumber : String) : Member
  + getCatalogue() : Catalogue
}

' Inheritance
Item <|-- BorrowableItem
Item <|-- ReferenceItem
BorrowableItem <|-- Book
BorrowableItem <|-- DVD
Borrowable <|.. BorrowableItem
LibraryUser <|-- Member
LibraryUser <|-- Librarian

' Associations
Library "1" *-- "1" Catalogue
Library "1" o-- "*" Member
Catalogue "1" o-- "*" Item
BorrowableItem "1" --> "0..1" Loan : currentLoan
BorrowableItem "1" --> "*" Hold : holds
Loan "*" --> "1" Member
Hold "*" --> "1" Member
Member "1" --> "*" Loan : loans
Librarian ..> Catalogue : adds items to
Librarian ..> Member : waives fee of

@enduml
